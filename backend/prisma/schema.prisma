// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Crop {
  id            Int       @id @default(autoincrement())
  nameEn        String
  nameHi        String
  slug          String    @unique
  mspPerQuintal Float?
  createdAt     DateTime  @default(now())
  bookings      Booking[]
}

model Mandi {
  id        Int       @id @default(autoincrement())
  nameEn    String
  nameHi    String
  slug      String    @unique
  district  String
  state     String
   latitude  Float?
  longitude Float?
  createdAt DateTime  @default(now())
  bookings  Booking[]
}

model Booking {
  id              Int      @id @default(autoincrement())
  tokenNumber     String   @unique
  farmerName      String
  farmerPhone     String
  cropId          Int
  crop            Crop     @relation(fields: [cropId], references: [id])
  mandiId         Int
  mandi           Mandi    @relation(fields: [mandiId], references: [id])
  quantityQuintal Float
  slotDate        DateTime
  status          String   @default("CONFIRMED")
  createdAt       DateTime @default(now())
}