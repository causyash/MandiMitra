generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Crop {
  id            Int      @id @default(autoincrement())
  nameEn        String
  nameHi        String
  slug          String   @unique
  mspPerQuintal Float?
  createdAt     DateTime @default(now())
}